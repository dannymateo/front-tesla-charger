# API Gateway (backend runs on 3000)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Must match backend JWT_SECRET for middleware verification
JWT_SECRET=change_me

# Frontend URL (for PayPal return — update backend .env PAYPAL_RETURN/CANCEL URLs to this port)
NEXT_PUBLIC_APP_URL=http://localhost:3001
